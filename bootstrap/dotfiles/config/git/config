[init]
	defaultBranch = master

[core]
	whitespace = space-before-tab, trailing-space, cr-at-eol
	editor = hx
	precomposeunicode = true
	commentchar = |
	pager = less --tabs=4 -RFX

[user]
	name = Hiroshi SHIBATA
	email = hsbt@ruby-lang.org
	signingkey = F9CF13417264FAC2

[commit]
	gpgsign = true

[url "ssh://git@github.com/"]
	insteadOf = https://github.com/

[diff]
	algorithm = histogram

[log]
	date = iso

[blame]
	ignoreRevsFile = .git-blame-ignore-revs

[branch]
	autosetupmerge = true
	autosetuprebase = always
	sort = -authordate

[checkout]
	defaultRemote = origin

[merge]
	renameLimit = 999999

[rebase]
	autostash = true
	abbreviateCommands = true
	autosquash = true

[rerere]
	enabled = true

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true
	parallel = 8

[fetch "fsck"]
	zeroPaddedFilemode = ignore

[submodule]
	fetchJobs = 8

[transfer]
	fsckObjects = true

[feature]
	manyFiles = true

[index]
	skipHash = true

[pack]
	allowPackReuse = multi

[protocol "file"]
	allow = always

[advice]
	detachedHead = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[github]
	user = hsbt

[heroku]
	account = hsbt

[alias]
	a  = add -A
	b  = branch
	ba = branch -a
	bc = branch-cleanup
	c  = commit -S
	aic = "!f() { COMMITMSG=$(claude -p 'Generate ONLY a one-line Git commit message in English, using imperative mood, summarizing what was changed and why, based strictly on the contents of `git diff --cached`. Do not add explanation or a body. Output only the commit summary line.' 2>/dev/null | sed '/^$/d' | tail -n 1); git commit -S -m \"$COMMITMSG\" -e; }; f"
	ca = commit -S --amend
	co = checkout
	d  = diff
	ds = diff --staged
	dn = diff --name-only
	ga = gc --aggressive
	up = !git pull --rebase --prune $@ && git submodule update --init --recursive
	s  = status -sb
	t  = tag -s
	rv = remote -v
	l  = log --decorate
	lo = log --decorate --oneline
	lp = log --decorate -p
	lpf = log --decorate -p --follow
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
[wt]
	basedir = .claude/worktrees
