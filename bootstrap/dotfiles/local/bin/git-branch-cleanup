#!/usr/bin/env ruby
# frozen_string_literal: true

# Session-aware cleanup of local branches and Claude worktrees.
# Run `git branch-cleanup -h` for usage (--help goes to man, as with any
# git subcommand).

require "json"
require "open3"
require "optparse"

class BranchCleanup
  PROTECTED_GLOBS = %w[
    master main trunk develop
    ruby_* release/* *-stable maint* v[0-9]*
  ].freeze

  # Maintenance lines named after a bare version: rubygems 4.0, rails 7.1.
  VERSION_BRANCH = /\A\d+(\.\d+)+\z/

  SESSION_STORES = [
    "~/Library/Application Support/Claude/claude-code-sessions",
    "~/.config/Claude/claude-code-sessions",
    "~/AppData/Roaming/Claude/claude-code-sessions"
  ].freeze

  LEASE_REGISTRIES = [
    "~/Library/Application Support/Claude/git-worktrees.json",
    "~/.config/Claude/git-worktrees.json",
    "~/AppData/Roaming/Claude/git-worktrees.json"
  ].freeze

  CLAUDE_WORKTREES = "/.claude/worktrees/"

  # git cherry derives a patch-id for every commit on both sides of the
  # symmetric difference, so it stops paying for itself once the base has
  # drifted this far ahead.
  CHERRY_LIMIT = 10_000

  JOBS = 8

  Branch = Struct.new(:name, :sha, :upstream, :track, :date, :ahead, :behind,
    :worktree, :session, :pr, :merge, :base, :bucket, :reason)

  Worktree = Struct.new(:path, :branch, :intended, :detached, :prunable, :locked,
    :dirty, :session, :leased, :main, :here, :bucket, :reason, :size, :last)

  def self.run(argv)
    new(argv).run
  end

  def initialize(argv)
    @opts = {pr: true, worktrees: true, branches: true, orphans: false,
             json: false, apply: false, yes: false, dry_run: false,
             verbose: false, base: nil, stale_days: 30}
    parse!(argv)
    @warnings = []
    @branches = []
    @worktrees = []
  end

  def run
    detect_repo
    load_worktrees
    load_sessions
    load_branches
    classify
    lookup_prs if @opts[:pr]
    finalize
    plan_worktrees

    return emit_json if @opts[:json]

    report
    execute if proceed?
    0
  end

  private

  def parse!(argv)
    OptionParser.new do |o|
      o.banner = "usage: git branch-cleanup [options]"
      o.on("-n", "--dry-run", "report only, never delete") { @opts[:dry_run] = true }
      o.on("--apply", "delete the safe branches and worktrees without asking") { @opts[:apply] = true }
      o.on("-y", "--yes", "answer yes to the confirmation prompt") { @opts[:yes] = true }
      o.on("--json", "machine-readable output (implies --dry-run)") { @opts[:json] = true }
      o.on("--base BRANCH", "base to measure against (default: origin/HEAD)") { |v| @opts[:base] = v }
      o.on("--[no-]pr", "look up pull request state with gh (default: yes)") { |v| @opts[:pr] = v }
      o.on("--[no-]branches", "clean branches (default: yes)") { |v| @opts[:branches] = v }
      o.on("--[no-]worktrees", "clean Claude worktrees (default: yes)") { |v| @opts[:worktrees] = v }
      o.on("--worktrees-only", "leave every branch alone") { @opts[:branches] = false }
      o.on("--stale-days N", Integer, "idle days after which a worktree of an unmerged branch is stale (default: 30)") do |v|
        @opts[:stale_days] = v
      end
      o.on("--remove-orphans", "also delete leftover directories git no longer tracks") { @opts[:orphans] = true }
      o.on("-v", "--verbose", "list protected branches and kept worktrees too") { @opts[:verbose] = true }
      o.on("-h", "--help", "show this message") do
        puts o
        exit 0
      end
    end.parse!(argv)
    @opts[:dry_run] = true if @opts[:json]
  end

  # --- repository -----------------------------------------------------------

  def detect_repo
    @root = capture("git", "rev-parse", "--show-toplevel", chdir: Dir.pwd).strip
    abort "git branch-cleanup: not inside a git repository" if @root.empty?
    @current = git("rev-parse", "--abbrev-ref", "HEAD").strip
    @base = @opts[:base] || default_base
    abort "git branch-cleanup: base #{@base} does not exist" unless rev?(@base)
    @nwo = github_repo
  end

  def default_base
    head = git("symbolic-ref", "--quiet", "refs/remotes/origin/HEAD").strip
    return head.sub("refs/remotes/", "") unless head.empty?

    %w[origin/master origin/main master main].find { |r| rev?(r) } ||
      abort("git branch-cleanup: cannot determine the base branch, pass --base")
  end

  # gh infers the repository from whichever remote points at GitHub, which
  # matters in ruby/ruby where origin is git.ruby-lang.org.
  def github_repo
    return nil unless @opts[:pr]

    nwo = capture(*gh, "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner", chdir: @root).strip
    if nwo.empty?
      @opts[:pr] = false
      @warnings << "gh could not resolve a GitHub repository; pull request state is unavailable"
      return nil
    end
    nwo
  end

  def gh
    @gh ||= if which("gh")
      ["gh"]
    elsif which("mise")
      ["mise", "x", "--", "gh"]
    else
      @opts[:pr] = false
      @warnings << "gh is not on PATH; pull request state is unavailable"
      ["gh"]
    end
  end

  # --- inputs ---------------------------------------------------------------

  def load_worktrees
    here = File.realpath(Dir.pwd)
    entry = nil
    git("worktree", "list", "--porcelain").each_line do |line|
      case line.chomp
      when /\Aworktree (.+)\z/
        entry = Worktree.new(path: $1, main: @worktrees.empty?)
        @worktrees << entry
      when %r{\Abranch refs/heads/(.+)\z} then entry.branch = $1
      when "detached" then entry.detached = true
      when "prunable", /\Aprunable / then entry.prunable = true
      when "locked", /\Alocked / then entry.locked = true
      end
    end
    @main_worktree = @worktrees.first&.path || @root
    leases = lease_registry

    @worktrees.each do |w|
      w.here = here == w.path || here.start_with?(w.path + "/")
      w.leased = leases.dig(w.path, "leasedBy")
      # A detached worktree has no branch of its own, so the registry is the
      # only place its original branch name survives, for the report.
      w.intended = leases.dig(w.path, "branch")
      next if w.main || w.prunable

      w.dirty = !capture("git", "status", "--porcelain", chdir: w.path).strip.empty?
      w.last = capture("git", "log", "-1", "--format=%ct", chdir: w.path).to_i
    end
    @worktree_by_branch = @worktrees.reject { |w| w.main || w.detached }.to_h { |w| [w.branch, w] }
    scan_orphans
  end

  # Claude Desktop leases a worktree to one session at a time; an entry with a
  # leaseholder is in use even when the branch looks finished.
  def lease_registry
    file = LEASE_REGISTRIES.map { |p| File.expand_path(p) }.find { |p| File.exist?(p) }
    return {} unless file

    (read_json(file) || {}).fetch("worktrees", {}).values.to_h { |e| [e["path"], e] }
  end

  # Killing the app mid-run can leave a directory behind that git never knew
  # about, and nothing else ever reclaims it.
  def scan_orphans
    known = @worktrees.map(&:path)
    Dir.glob(File.join(@main_worktree, ".claude", "worktrees", "*")).each do |dir|
      next unless File.directory?(dir) && !known.include?(dir)

      @worktrees << Worktree.new(path: dir, bucket: :orphan, reason: "git does not track this directory")
    end
  end

  # Claude Desktop keeps one JSON file per session; `branch` plus `isArchived`
  # is what separates a finished session from one the user still has open.
  def load_sessions
    @sessions = {}
    @session_by_id = {}
    by_path = {}
    dir = SESSION_STORES.map { |p| File.expand_path(p) }.find { |p| Dir.exist?(p) }
    unless dir
      @warnings << "Claude session store not found; every claude/* branch and worktree is kept"
      @no_session_store = true
      return
    end

    live_ids, live_cwds = live_cli_sessions
    Dir.glob(File.join(dir, "**", "local_*.json")).each do |file|
      data = read_json(file) or next
      next unless in_repo?(data["originCwd"] || data["cwd"])

      # Worktrees get handed to a new session once the old one is archived, so
      # only the running process id proves a session is still attached.
      s = {"id" => data["sessionId"], "title" => data["title"].to_s,
           "archived" => !!data["isArchived"], "last" => data["lastActivityAt"].to_i,
           "worktree" => data["worktreePath"],
           "live" => live_ids.include?(data["cliSessionId"])}
      @session_by_id[s["id"]] = s
      if (branch = data["branch"])
        @sessions[branch] = s if better?(s, @sessions[branch])
      end
      # A session started inside a worktree records the path in cwd, and
      # leaves worktreePath null more often than not.
      [data["worktreePath"], data["cwd"]].compact.uniq.each do |wt|
        by_path[wt] = s if wt != @main_worktree && better?(s, by_path[wt])
      end
    end

    @worktrees.each do |w|
      w.session = by_path[w.path] || (w.branch && @sessions[w.branch])
      w.session = (w.session || {"title" => "", "archived" => false}).merge("live" => true) if live_cwds.include?(w.path)
      w.last = [w.last.to_i, w.session["last"].to_i / 1000].max if w.session
    end
  end

  # A worktree is reused by session after session, so the one that decides its
  # fate is the most alive, not the most recent.
  def better?(candidate, current)
    current.nil? || (rank(candidate) <=> rank(current)) > 0
  end

  def rank(session)
    [session["live"] ? 1 : 0, session["archived"] ? 0 : 1, session["last"]]
  end

  # The CLI writes a registry entry per running process; a live pid is the one
  # signal strong enough to override everything else below.
  def live_cli_sessions
    dirs = [ENV["CLAUDE_CONFIG_DIR"], "~/.config/claude", "~/.claude"].compact
    entries = dirs.flat_map { |d| Dir.glob(File.join(File.expand_path(d), "sessions", "*.json")) }
      .filter_map { |f| read_json(f) }
      .select { |d| alive?(d["pid"]) }
    [entries.map { |d| d["sessionId"] }, entries.map { |d| d["cwd"] }]
  end

  def alive?(pid)
    return false unless pid.is_a?(Integer)

    Process.kill(0, pid)
    true
  rescue Errno::EPERM
    true
  rescue Errno::ESRCH
    false
  end

  def in_repo?(path)
    return false unless path

    path == @main_worktree || path.start_with?(@main_worktree + "/")
  end

  def load_branches
    fmt = "%(refname:short)\t%(objectname)\t%(upstream:short)\t%(upstream:track)\t%(committerdate:short)"
    git("for-each-ref", "--format=#{fmt}", "refs/heads").each_line do |line|
      name, sha, upstream, track, date = line.chomp.split("\t", 5)
      next if name.nil? || name.empty?

      @branches << Branch.new(name: name, sha: sha, upstream: upstream, track: track.to_s,
        date: date, worktree: @worktree_by_branch[name], session: @sessions[name])
    end
  end

  # --- branch classification ------------------------------------------------

  def classify
    @branches.each do |b|
      if protected?(b.name)
        hold(b, :protected, "protected")
      elsif b.name == @current
        hold(b, :protected, "checked out here")
      elsif b.session && b.session["live"]
        hold(b, :active, "session running#{title(b)}")
      elsif b.worktree&.dirty
        hold(b, :active, "worktree has uncommitted changes")
      elsif @no_session_store && b.name.start_with?("claude/")
        hold(b, :active, "no Claude session store to check against")
      else
        behind, ahead = git("rev-list", "--left-right", "--count", "#{@base}...#{b.name}").split
        b.behind = behind.to_i
        b.ahead = ahead.to_i
        b.merge = merge_state(b)
      end
    end
  end

  def merge_state(branch)
    branch.base = @base
    return :ancestor if branch.ahead.zero?
    return :unknown if branch.behind > CHERRY_LIMIT
    return :equivalent if cherry_clean?(@base, branch.name)

    # A backport lands on the stable branch its own name points at, never on
    # the trunk measured above.
    stable_bases.each do |alt|
      next unless branch.name.include?(alt.delete_prefix("origin/"))

      branch.base = alt
      return :ancestor if ahead_of(alt, branch.name).zero?
      return :equivalent if cherry_clean?(alt, branch.name)
    end
    branch.base = @base
    :unmerged
  end

  def cherry_clean?(base, branch)
    git("cherry", base, branch).each_line.none? { |l| l.start_with?("+") }
  end

  def ahead_of(base, branch)
    git("rev-list", "--count", "#{base}..#{branch}").to_i
  end

  def stable_bases
    @stable_bases ||= git("for-each-ref", "--format=%(refname:short)", "refs/remotes/origin")
      .lines.map(&:chomp)
      .reject { |r| r == @base || r.end_with?("/HEAD") }
      .select { |r| protected?(r.delete_prefix("origin/")) }
  end

  # A squash- or rebase-merged branch keeps none of its original commits, so
  # the pull request is the only remaining evidence that the work landed.
  def lookup_prs
    return if @nwo.nil?

    open = open_prs
    @branches.each { |b| b.pr = open[b.name] if b.bucket.nil? }
    # Everything else is already provably merged, so the only question left is
    # whether a rebase or squash hid the evidence.
    pending = @branches.select { |b| b.bucket.nil? && b.pr.nil? && %i[unmerged unknown].include?(b.merge) }
    return if pending.empty?

    each_parallel(pending) do |b|
      list = read_json_string(capture(*gh, "pr", "list", "--repo", @nwo, "--head", b.name,
        "--state", "all", "--limit", "5", "--json", "number,state,url")) || []
      b.pr = list.find { |p| p["state"] == "OPEN" } ||
        list.find { |p| p["state"] == "MERGED" } || list.first
    end
  end

  def open_prs
    list = read_json_string(capture(*gh, "pr", "list", "--repo", @nwo, "--state", "open",
      "--author", "@me", "--limit", "100",
      "--json", "number,state,url,headRefName", chdir: @root))
    (list || []).to_h { |p| [p["headRefName"], p] }
  end

  def finalize
    @branches.each do |b|
      next if b.bucket

      if b.pr && b.pr["state"] == "OPEN"
        hold(b, :active, "PR ##{b.pr["number"]} is open")
      elsif merged?(b)
        if b.session && !b.session["archived"]
          hold(b, :session_open, "#{merge_reason(b)}, session still open#{title(b)}")
        else
          hold(b, :delete, merge_reason(b))
        end
      else
        hold(b, :ask, unmerged_reason(b))
      end
    end
  end

  def merged?(branch)
    %i[ancestor equivalent].include?(branch.merge) || branch.pr&.dig("state") == "MERGED"
  end

  def merge_reason(branch)
    case branch.merge
    when :ancestor then "merged into #{branch.base}"
    when :equivalent then "all #{branch.ahead} commits are in #{branch.base}"
    else "PR ##{branch.pr["number"]} merged"
    end
  end

  def unmerged_reason(branch)
    parts = ["#{branch.ahead} unmerged commit#{"s" unless branch.ahead == 1}", "last commit #{branch.date}"]
    parts << "upstream gone" if branch.track.include?("gone")
    parts << "PR ##{branch.pr["number"]} #{branch.pr["state"].downcase}" if branch.pr
    parts << "session archived#{title(branch)}" if branch.session
    parts.join(", ")
  end

  def protected?(name)
    return true if VERSION_BRANCH.match?(name)

    @protect_globs ||= PROTECTED_GLOBS + git("config", "--get-all", "branchcleanup.protect").lines.map(&:chomp)
    @protect_globs.any? { |g| File.fnmatch?(g, name) }
  end

  def hold(branch, bucket, reason)
    branch.bucket = bucket
    branch.reason = reason
  end

  def title(obj)
    t = obj.session ? obj.session["title"].to_s : ""
    t.empty? ? "" : %( "#{t}")
  end

  # --- worktree classification ----------------------------------------------

  def plan_worktrees
    deleting = @branches.select { |b| b.bucket == :delete }.map(&:name)
    unmerged = @branches.select { |b| b.bucket == :ask }.map(&:name)

    @worktrees.each do |w|
      next if w.main || w.bucket == :orphan

      keep(w, "current working tree") if w.here
      keep(w, "locked") if w.locked
      take(w, :prune, "directory is gone") if w.prunable
      next if w.bucket

      unless w.path.include?(CLAUDE_WORKTREES)
        keep(w, "not a Claude worktree")
        next
      end

      if w.session && w.session["live"]
        keep(w, "session running")
      elsif leaseholder_open?(w)
        keep(w, "leased by an open session")
      elsif w.dirty
        keep(w, "uncommitted changes")
      elsif w.session && !w.session["archived"]
        keep(w, "session still open#{title(w)}")
      elsif w.branch.nil? || deleting.include?(w.branch)
        take(w, :remove, finished_reason(w))
      elsif unmerged.include?(w.branch)
        # Only the checkout goes; the branch and its commits stay behind, so
        # the cost of being wrong here is a rebuild, not lost work.
        idle = idle_days(w)
        if idle >= @opts[:stale_days]
          take(w, :remove, "#{w.branch} unmerged, idle #{idle}d, branch kept")
        else
          take(w, :ask, "#{w.branch} unmerged, idle #{idle}d, branch would be kept")
        end
      else
        keep(w, "branch #{w.branch} is kept")
      end
    end
    measure_sizes
  end

  # An unknown leaseholder means the session is gone, so fall through to the
  # checks below rather than keeping the worktree forever.
  def leaseholder_open?(worktree)
    holder = @session_by_id[worktree.leased]
    !holder.nil? && !holder["archived"]
  end

  def finished_reason(worktree)
    return "branch is being deleted" if worktree.branch

    was = worktree.intended ? " (was #{worktree.intended})" : ""
    worktree.session ? "detached#{was}, session finished" : "detached#{was}, no session on record"
  end

  def idle_days(worktree)
    return 0 if worktree.last.to_i.zero?

    ((Time.now.to_i - worktree.last.to_i) / 86_400.0).floor
  end

  def keep(worktree, reason)
    take(worktree, :keep, reason)
  end

  def take(worktree, bucket, reason)
    return if worktree.bucket

    worktree.bucket = bucket
    worktree.reason = reason
  end

  def measure_sizes
    targets = @worktrees.select { |w| %i[remove ask orphan].include?(w.bucket) }
    each_parallel(targets) { |w| w.size = capture("du", "-sk", w.path).split.first.to_i }
  end

  # --- output ---------------------------------------------------------------

  def report
    @warnings.each { |w| warn "warning: #{w}" }
    puts "base #{@base}#{" (#{@nwo})" if @nwo}"

    branch_section("delete", :delete)
    branch_section("ask", :ask)
    branch_section("keep (session open)", :session_open)
    branch_section("keep (active)", :active)
    branch_section("keep (protected)", :protected) if @opts[:verbose]

    worktree_section("worktrees to remove", :remove)
    worktree_section("worktrees to decide", :ask)
    worktree_section("worktrees to prune", :prune)
    worktree_section("orphan directories", :orphan)
    worktree_section("worktrees kept", :keep) if @opts[:verbose]

    kept = @branches.count { |b| b.bucket == :protected }
    puts "", "#{kept} protected branch#{"es" unless kept == 1} kept#{" (-v to list)" unless @opts[:verbose]}"
    puts "nothing to clean up" if to_delete.empty? && to_remove.empty? && to_prune.empty?
  end

  def branch_section(label, bucket)
    rows = @branches.select { |b| b.bucket == bucket }
    return if rows.empty?

    puts "", "#{label} (#{rows.size})"
    rows.sort_by(&:name).each { |b| puts format("  %-52s %s", b.name, b.reason) }
    puts "  decide these one by one, by hand or with /branch-cleanup" if bucket == :ask
  end

  def worktree_section(label, bucket)
    rows = @worktrees.select { |w| w.bucket == bucket }
    return if rows.empty?

    total = rows.sum { |w| w.size.to_i }
    puts "", "#{label} (#{rows.size}#{", #{human(total)}" if total.positive?})"
    rows.sort_by(&:path).each do |w|
      line = format("  %-48s", relative(w.path))
      line += format(" %8s", human(w.size)) if total.positive?
      puts "#{line}  #{w.reason}"
    end
    puts "  removing these keeps every branch; only the checkout goes" if bucket == :ask
    puts "  pass --remove-orphans to delete them" if bucket == :orphan && !@opts[:orphans]
  end

  def human(kilobytes)
    return "" if kilobytes.nil? || kilobytes.zero?
    return format("%.1f GB", kilobytes / 1_048_576.0) if kilobytes >= 1_048_576
    return format("%d MB", kilobytes / 1024) if kilobytes >= 1024

    format("%d KB", kilobytes)
  end

  def emit_json
    puts JSON.pretty_generate(
      repo: @root, github: @nwo, base: @base, stale_days: @opts[:stale_days], warnings: @warnings,
      branches: @branches.map do |b|
        {name: b.name, sha: b.sha, bucket: b.bucket, reason: b.reason,
         merge: b.merge, base: b.base, ahead: b.ahead, behind: b.behind, date: b.date,
         upstream: b.upstream, track: b.track, pr: b.pr,
         worktree: b.worktree&.path, session: b.session}
      end,
      worktrees: @worktrees.reject(&:main).map do |w|
        {path: w.path, branch: w.branch, intended: w.intended, detached: w.detached,
         dirty: w.dirty, prunable: w.prunable, locked: w.locked, leased: w.leased,
         bucket: w.bucket, reason: w.reason, kilobytes: w.size,
         idle_days: idle_days(w), session: w.session}
      end
    )
    0
  end

  def relative(path)
    path.start_with?(@main_worktree + "/") ? path[(@main_worktree.size + 1)..] : path
  end

  # --- execution ------------------------------------------------------------

  def to_delete
    return [] unless @opts[:branches]

    @branches.select { |b| b.bucket == :delete }
  end

  def to_remove
    return [] unless @opts[:worktrees]

    @worktrees.select { |w| w.bucket == :remove } +
      (@opts[:orphans] ? @worktrees.select { |w| w.bucket == :orphan } : [])
  end

  def to_prune
    @opts[:worktrees] ? @worktrees.select { |w| w.bucket == :prune } : []
  end

  def proceed?
    return false if @opts[:dry_run]
    return false if to_delete.empty? && to_remove.empty? && to_prune.empty?
    return true if @opts[:apply] || @opts[:yes]

    unless $stdin.tty?
      puts "", "rerun with --apply to clean up"
      return false
    end
    reclaim = to_remove.sum { |w| w.size.to_i }
    puts ""
    print "delete #{to_delete.size} branch(es) and #{to_remove.size} worktree(s)" \
          "#{", reclaiming #{human(reclaim)}" if reclaim.positive?}? [y/N] "
    $stdin.gets.to_s.strip.downcase.start_with?("y")
  end

  def execute
    puts ""
    run_git("worktree", "prune") if to_prune.any?
    to_remove.each do |w|
      if w.bucket == :orphan
        require "fileutils"
        FileUtils.rm_rf(w.path)
        puts "  Removed orphan directory #{relative(w.path)}."
      else
        run_git("worktree", "remove", w.path)
      end
    end
    to_delete.each do |b|
      # -d refuses a branch whose commits were rebased or squashed on the way
      # in, which is exactly what merge detection just proved happened.
      run_git("branch", (b.merge == :ancestor) ? "-d" : "-D", b.name)
    end
  end

  def run_git(*args)
    out, status = Open3.capture2e("git", "-C", @root, *args)
    puts out.lines.map { |l| "  #{l}" }.join.chomp unless out.strip.empty?
    status.success?
  end

  # --- helpers --------------------------------------------------------------

  def each_parallel(items)
    return if items.empty?

    queue = Queue.new
    items.each { |i| queue << i }
    Array.new([JOBS, items.size].min) do
      Thread.new do
        loop do
          item = begin
            queue.pop(true)
          rescue ThreadError
            break
          end
          yield item
        end
      end
    end.each(&:join)
  end

  def git(*args)
    capture("git", "-C", @root, *args)
  end

  def rev?(ref)
    system("git", "-C", @root, "rev-parse", "--verify", "--quiet", "#{ref}^{commit}",
      out: File::NULL, err: File::NULL)
  end

  def read_json(file)
    read_json_string(File.read(file))
  rescue
    nil
  end

  def read_json_string(text)
    JSON.parse(text)
  rescue
    nil
  end

  def capture(*cmd, chdir: nil)
    out, status = chdir ? Open3.capture2(*cmd, chdir: chdir) : Open3.capture2(*cmd)
    status.success? ? out : ""
  rescue
    ""
  end

  def which(cmd)
    ENV["PATH"].to_s.split(File::PATH_SEPARATOR).any? do |dir|
      path = File.join(dir, cmd)
      File.executable?(path) && !File.directory?(path)
    end
  end
end

exit BranchCleanup.run(ARGV) if $PROGRAM_NAME == __FILE__
